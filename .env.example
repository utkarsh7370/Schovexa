# Copy to .env and fill in real values. Never commit .env with real secrets.
# See docs/architecture.md and docs/authentication.md for what each of
# these backs.

NODE_ENV=development

# --- API (apps/api) ---
PORT=4000
DATABASE_URL="postgresql://schovexa:schovexa_dev_password@localhost:5432/schovexa_dev?schema=public"
REDIS_URL="redis://localhost:6379"

# Comma-separated list of allowed frontend origins for CORS.
# Never use "*" — see docs/architecture.md CORS amendment.
WEB_ORIGIN="http://localhost:3000"

# Session cookie secret / signing key — generate with a CSPRNG, never reuse
# across environments.
SESSION_SECRET="change-me"

# Object storage (S3-compatible — AWS S3, Cloudflare R2, Backblaze B2,
# or self-hosted MinIO all work). Leave all four blank to fall back to
# local-disk storage (dev only — files don't survive a redeploy and
# aren't backed up). See docs/architecture.md §8.
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_REGION=""

# Outbound email (SMTP — works with SES, Resend, Postmark, SendGrid,
# Mailgun, or a Google Workspace account's SMTP relay). Leave SMTP_HOST
# blank to fall back to logging emails instead of sending them (dev
# only — invite/reset links still work, they just aren't emailed).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Schovexa <no-reply@schovexa.app>"

# Error monitoring (Sentry). Leave blank to disable — no events are
# captured or sent anywhere without a DSN (dev default).
SENTRY_DSN=""

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"

# Error monitoring (Sentry) — can be the same project as SENTRY_DSN
# above or a separate one. NEXT_PUBLIC_ so it's available to client,
# server, and edge runtimes alike (a DSN is not secret — it only accepts
# event submissions, never reads). Leave blank to disable.
NEXT_PUBLIC_SENTRY_DSN=""
