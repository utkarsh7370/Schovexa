# Copy to .env and fill in real values. Never commit .env with real secrets.
# See docs/architecture.md and docs/authentication.md for what each of
# these backs.

NODE_ENV=development

# --- API (apps/api) ---
PORT=4000
DATABASE_URL="postgresql://schovexa:schovexa_dev_password@localhost:5432/schovexa_dev?schema=public"
REDIS_URL="redis://localhost:6379"

# --- Security (see docs/security-rules.md) ---
# Make people confirm their email before sensitive actions (inviting,
# changing roles, disabling access). Default: true in production, false
# otherwise. Needs SMTP_* below so the confirmation link can be delivered.
REQUIRE_EMAIL_VERIFICATION="false"
# How long a password confirmation stays fresh for sensitive actions.
REAUTH_WINDOW_MINUTES="10"
# Requests per minute per IP across the whole API (tighter limits apply to
# login, register, reset, invitations). Counters use REDIS_URL when set.
RATE_LIMIT_PER_MINUTE="600"
# Development only: multiplies every request limit by 100 so the demo-data
# seeder (scripts/seed-demo-school.js) can be run repeatedly. Ignored when
# NODE_ENV=production. Leave it off on a real server.
# DEV_RELAX_RATE_LIMITS="true"
# Behind a reverse proxy or load balancer set the number of proxies in
# front of the API (usually 1) so rate limits and the audit log see the
# real client IP. Leave unset when the API is exposed directly.
# TRUST_PROXY="1"

# Comma-separated list of allowed frontend origins for CORS.
# Never use "*" — see docs/architecture.md CORS amendment.
WEB_ORIGIN="http://localhost:3000"

# Session cookie secret / signing key — generate with a CSPRNG, never reuse
# across environments.
SESSION_SECRET="change-me"

# Object storage (S3-compatible — AWS S3, Cloudflare R2, Backblaze B2,
# or self-hosted MinIO all work). Leave all four blank to fall back to
# local-disk storage (dev only — files don't survive a redeploy and
# aren't backed up). See docs/architecture.md §8.
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_REGION=""

# ----------------------------------------------------------------------
# EMAIL — every setting is here; nothing about email is hardcoded.
# Fill in the lines for ONE of the two options below and email works.
# Leave it all blank and email is simply OFF: messages are logged instead
# of sent (invite and reset links still appear on screen), so local
# development needs nothing.  Check your setup any time with:
#     npm run email:test -w @schovexa/api -- you@example.com
# ----------------------------------------------------------------------

# OPTION 1 — pick a provider, then give only your login:
#   gmail | outlook | zoho | brevo | sendgrid | mailgun | resend | postmark | ses | custom
EMAIL_PROVIDER=""
SMTP_USER=""
SMTP_PASSWORD=""
#   gmail    → SMTP_USER = your address, SMTP_PASSWORD = an App Password
#   sendgrid → SMTP_USER = apikey,       SMTP_PASSWORD = your API key
#   resend   → SMTP_USER = resend,       SMTP_PASSWORD = your API key

# OPTION 2 — any other mail server (these override a provider's defaults):
SMTP_HOST=""
SMTP_PORT=""            # blank = the provider's port, else 587 (465 when SMTP_SECURE=true)
SMTP_SECURE=""          # true = TLS from the start (port 465); blank/false = STARTTLS (587)
# …or one line instead of the five above:  smtps://user:password@smtp.example.com:465
SMTP_URL=""

# Who the email comes from
EMAIL_FROM_NAME="Schovexa"                  # the display name people see
EMAIL_FROM_ADDRESS=""                       # blank = SMTP_USER if it is an address; must be one your provider allows
EMAIL_REPLY_TO=""                           # where replies go (blank = the From address)
EMAIL_BCC=""                                # comma-separated; secretly copied on every message
EMAIL_SUBJECT_PREFIX=""                     # e.g. "[Sunrise School]" put in front of every subject

# What the emails say
APP_NAME="Schovexa"                         # product/school-platform name used inside emails
APP_URL=""                                  # where links point; blank = the first WEB_ORIGIN
SUPPORT_EMAIL=""                            # shown as the help contact; also the contact-form inbox if CONTACT_INBOX_EMAIL is blank

# Safety switches
EMAIL_ENABLED="true"                        # false = switch email off without deleting the settings
EMAIL_REDIRECT_ALL_TO=""                    # staging: send EVERYTHING to this one address instead of real people
EMAIL_VERIFY_ON_START="true"                # log whether the mail server accepted our login at startup

# Advanced (rarely needed)
SMTP_REQUIRE_TLS=""                         # true = refuse to send unless the connection is encrypted
SMTP_REJECT_UNAUTHORIZED=""                 # false = accept a self-signed certificate (private servers only)
SMTP_POOL=""                                # true = keep connections open (high volume)
SMTP_CONNECTION_TIMEOUT_MS=""               # default 15000
# SMTP_FROM="Name <address>"                # older single-line form; still works, EMAIL_FROM_* is clearer

# Where messages from the website's "Contact us" form are emailed. Needs
# SMTP_* above to actually send; every message is also saved in the
# ContactMessage table, so nothing is lost while SMTP is unconfigured.
CONTACT_INBOX_EMAIL="utkarshsingh737091@gmail.com"

# Error monitoring (Sentry). Leave blank to disable — no events are
# captured or sent anywhere without a DSN (dev default).
SENTRY_DSN=""

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"

# Error monitoring (Sentry) — can be the same project as SENTRY_DSN
# above or a separate one. NEXT_PUBLIC_ so it's available to client,
# server, and edge runtimes alike (a DSN is not secret — it only accepts
# event submissions, never reads). Leave blank to disable.
NEXT_PUBLIC_SENTRY_DSN=""
