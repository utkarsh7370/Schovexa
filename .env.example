# Copy to .env and fill in real values. Never commit .env with real secrets.
# See docs/architecture.md and docs/authentication.md for what each of
# these backs.

NODE_ENV=development

# --- API (apps/api) ---
PORT=4000
DATABASE_URL="postgresql://schovexa:schovexa_dev_password@localhost:5432/schovexa_dev?schema=public"
REDIS_URL="redis://localhost:6379"

# Comma-separated list of allowed frontend origins for CORS.
# Never use "*" — see docs/architecture.md CORS amendment.
WEB_ORIGIN="http://localhost:3000"

# Session cookie secret / signing key — generate with a CSPRNG, never reuse
# across environments.
SESSION_SECRET="change-me"

# Object storage (S3-compatible) — see docs/architecture.md §8 and the open
# question in docs/product-requirements.md §9 on the exact provider.
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_REGION=""

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
